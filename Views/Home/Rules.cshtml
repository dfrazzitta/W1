@section Scripts
{
    <script>
        // A $( document ).ready() block.
        $(document).ready(function () {
          
        });

        function showAlert() {
            alert("A was pressed!");
        }


        let clickCount = 0;
        let lastClickTime = 0;
        const TRIPLE_CLICK_THRESHOLD = 300; // milliseconds
        let keysPressed = {};
        let  isVisiable = false;

        const myElement = document.getElementById('clicker');

        myElement.addEventListener('mousedown', (event) => {
            const currentTime = new Date().getTime();

            if (currentTime - lastClickTime < TRIPLE_CLICK_THRESHOLD) {
                clickCount++;
                 
            } else {
                clickCount = 1; // Start a new click sequence
            }

            lastClickTime = currentTime;

            if (clickCount === 3) {
                console.log('Triple-click down detected!');
                // Perform your desired action here
                clickCount = 0; // Reset for the next sequence
                var myLog = document.getElementById("loginForm");

                myLog.hidden = !myLog.hidden;
                isVisiable = true;

               // e.preventDefault();
            }
        });

        document.onkeyup = function(e) {

          if (e.keyCode ===  27 && isVisiable) {
                var myLog = document.getElementById("loginForm");
                myLog.hidden = !myLog.hidden;
                isVisiable = false;
               e.preventDefault();

          }
        };


    </script>

}




