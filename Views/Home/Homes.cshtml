@model IEnumerable<W1.Models.DynamicHomes>

 
<br />
<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        Homes For Sale
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>
 
<hr />


 
@foreach (var item in Model)
{
    <div class="row">
        <div class="col-sm-1">
        </div>
        <div class="col-sm-10 " width:100%; style="text-align: center;  font-size: 20pt; margin:1px 1px; padding:0px 0px; font-family: Brush Script MT, cursive;">
            <div class="justify-content-center">


                @Html.Raw(item.homelist)
                @*
                item.homelist);
                    *@
            </div>
        </div>
        <div class="col-sm-1">
        </div>
    </div>
}
 
<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        End of Listings
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>

 



@section Scripts
{
   
    <script>
        lightbox.option({
                   'resizeDuration': 200,
                   'wrapAround': true,
                   'maxwidth': 488,
                   'maxheight': 439
               });
                       
  
    </script>
}
 