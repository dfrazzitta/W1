@model IEnumerable<W1.Models.DynamicHomes>

<style>
    /* Tooltip container */
    .tooltipz {
        position: relative;
        display: inline-block;
        border-bottom: 1px dotted black; /* If you want dots under the hoverable text */
    }

        /* Tooltip text */
        .tooltipz .tooltiptextz {
            visibility: hidden;
            width: 120px;
            background-color: black;
            color: #fff;
            text-align: center;
            padding: 5px 0;
            border-radius: 6px;
            /* Position the tooltip text - see examples below! */
            position: absolute;
            z-index: 1;
        }

        /* Show the tooltip text when you mouse over the tooltip container */
        .tooltipz:hover .tooltiptext {
            visibility: visible;
        }
</style>

<br />
<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        Homes For Sale
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>
 
<hr />

 
@foreach (var item in Model)
{
    <div class="row">
        <div class="col-sm-1">
        </div>
        <div class="col-sm-10 " width:100%; style="text-align: center;  font-size: 20pt; margin:1px 1px; padding:0px 0px; font-family: Brush Script MT, cursive;">
            <div class="justify-content-center">

                
                         @Html.Raw(item.homelist)
               
                    
            </div>
        </div>
        <div class="col-sm-1">
        </div>
    </div>
}

<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        <h2 align="center">
            Lake Placid Park Inc.
            <br>
            980 7th St. NW
            <br>
            Largo, FL 33770
        </h2>
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>
    
     
 
 
 

 



