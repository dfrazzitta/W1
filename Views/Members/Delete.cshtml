@model W1.Models.Member
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Delete";
}

<h1 align="center"> Delete</h1>

<h2 align="center" class="blink-h2">Are you sure you want to delete this?</h2>
 
 
<div>
    <h4>Member</h4>
    <hr />
    
    <dl class="row mx-auto">
 
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TypeSell)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TypeSell)
        </dd>


        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LotNo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LotNo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AgentLastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AgentLastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AgentFirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AgentFirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OfficePhone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OfficePhone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CellPhone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CellPhone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AgentUrl)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AgentUrl)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ImageName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" onclick="return deletefile()" value="Delete" class="btn btn-danger" /> 
        <br />
        <a asp-action="Index" class="centerDelete">Back to List</a>
    </form>
    
</div>
 

@section Scripts
{
    <script>
        function deletefile(){
            
           // Swal.fire("SweetAlert2 is working!");
           // debugger;
            var r = confirm("Are you sure you want to delete this?");
            if (r == true) {
                //return true;
               
                return true;
            } else {
                return false;
            }
        }
    </script>

}
