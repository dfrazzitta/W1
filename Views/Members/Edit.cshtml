@model W1.Models.Member

@{
    ViewData["Title"] = "Edit";
}


<style>
    .centerSave {
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>


<h1 align="center">Edit</h1>

<h4 align="center">Member</h4>
<hr />
<div class="row">
    <div class="col-3 w-25 p-3">
    </div>
    <div class="col-md-6">
        <form id="target" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />

            @*
                <input id="TypeSell" name="TypeSell"
                       asp-for="TypeSell" data-html="true" list="examplefsbo" value=""
                       data-html="true"
                       class="form-control w-2 p-2 mx-auto d-flex" />

                <datalist id="examplefsbo">
                    <option value="Agent" />
                    <option value="FSBO" />
                </datalist>
                <span asp-validation-for="TypeSell" class="text-danger"></span>
                *@

            <div class="form-group">
                <label asp-for="TypeSell" class="control-label"></label>
                <input asp-for="TypeSell" id="test" readonly  class="form-control" />

                <span asp-validation-for="TypeSell" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="LotNo" class="control-label"></label>
                <input id="LotNo" asp-for="LotNo" readonly class="form-control" />

                <span asp-validation-for="LotNo" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" maxlength="15" style="width:110px; " class="form-control  mx-auto d-flex" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AgentLastName" class="control-label"></label>
                <input asp-for="AgentLastName" class="form-control"   />
                <span asp-validation-for="AgentLastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AgentFirstName" class="control-label"></label>
                <input asp-for="AgentFirstName" class="form-control"   />
                <span asp-validation-for="AgentFirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control"   />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OfficePhone" class="control-label"></label>
                <input asp-for="OfficePhone" class="form-control"   />
                <span asp-validation-for="OfficePhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CellPhone" class="control-label"></label>
                <input asp-for="CellPhone" class="form-control"   />
                <span asp-validation-for="CellPhone" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="AgentUrl" class="control-label" style="visibility: hidden"></label>
                <input asp-for="AgentUrl" class="form-control"  style="visibility: hidden"/>
                <span asp-validation-for="AgentUrl" class="text-danger"></span>
            </div>
             
             
            <div class="form-group">
                <label asp-for="ImageName" class="control-label"></label>
                <input asp-for="ImageName" readonly class="form-control" />
                <span asp-validation-for="ImageName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary centerSave" />
            </div>

        </form>
    </div>
    <div class="col-3 w-25 p-3">


        <button class="btn btn-primary" id="button1" onclick="HelpTypeSellInfo()">ReadMe</button>
        
    </div>
</div>

<div align="center">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts
{
    <script>
 
                window.onload = function() {
                };
 
                $(document).ready(function() {
                        $('#target').on('submit', function(e) {
                                e.preventDefault(); // Prevent default form submission
                                debugger;
                                var formData = new FormData(this); // Create FormData object from the form

                                // You can also append additional data manually if needed
                                // formData.append('extraData', 'someValue');

                                $.ajax({
                                    url:  '@Url.Action("Edit", "Members")', // Replace with your server-side endpoint (e.g., ASP.NET Core controller action)
                                    type: 'POST',
                                    data: formData,
                                    processData: false, // Important: Don't process the data, let FormData handle it
                                    contentType: false, // Important: Don't set content type, FormData handles it
                                    success: function(response) {
                                        console.log('Upload successful:', response);
                                        // Handle success response
                                    },
                                    error: function(xhr, status, error) {
 
                                        // Example of accessing specific properties:
                                        if (xhr.status === 404) {
                                            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="32"><path d="M342.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L160 178.7l-57.4-57.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l80 80c12.5 12.5 32.8 12.5 45.3 0l160-160zm96 128c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L160 402.7 54.6 297.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l128 128c12.5 12.5 32.8 12.5 45.3 0l256-256z" fill="currentColor" /></svg>'
                                            Swal.fire({
                                                title: "Information",
                                                text: "Appears a record exists for this Lot",
                                                icon:
                                                "Error"
                                            });

                                        } else {
                                            console.error('An unexpected error occurred.');
                                        }
                                        // Handle error
                                    }
                                });
                            });
                        });
                });
 
    </script>
}






