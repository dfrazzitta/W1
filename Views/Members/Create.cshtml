<style>
    .tooltipx {
        position: relative;
        display: inline-block;
        border-bottom: 1px dotted black;
    }

        .tooltipx .tooltiptextx {
            visibility: hidden;
            width: 120px;
            background-color: black;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 5px 0;
            /* Position the tooltip */
            position: absolute;
            z-index: 1;
        }

        .tooltipx:hover .tooltiptextx {
            visibility: visible;
        }
</style>





