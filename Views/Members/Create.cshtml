            @*
                https://www.geeksforgeeks.org/us-currency-validation-using-regular-expressions/
                https://codepen.io/559wade/pen/LRzEjj
            *@
            <div class="text-center">
                <label asp-for="Price" class="control-label"><b>Unit Price </b></label><br />
                <input id="currency-field" type='text' pattern="^\$\d{1,3}(,\d{3})*(\.\d+)?$" value=""
                       data-type="currency" name="Price"
                       class="form-control w-2 p-2 mx-auto d-flex" autocomplete="off"
                       data-bs-toggle="tooltip" data-bs-placement="right" data-bs-title="Please enter Price in decimal format" />

            </div>

            <div class="text-center">
