    <script>


        function HelpTypeSellInfo()
                {
                        const doubleCheckIcon =

                                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="32"><path d="M342.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L160 178.7l-57.4-57.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l80 80c12.5 12.5 32.8 12.5 45.3 0l160-160zm96 128c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L160 402.7 54.6 297.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l128 128c12.5 12.5 32.8 12.5 45.3 0l256-256z" fill="currentColor" /></svg>'
                            Swal.fire({
                                title: "Information",
                                html: '1.  Take Picture and use horizontal view <br /> \
                                         2.   Send Image to your local email <br> \
                                         3.   Download the image to your local machine <br/> \
                                         4.   Choose the image with the Choose File dialog (must be a jpeg/jpg) <br/> \
                                         5.   Click the Submit button in the box <br/> \
                                         6.   The software will display the NEW image in the image box <br/> \
                                         7.   If image looks acceptable then press the CTRL-F5 keys at the same time <br/> \
                                         8.   The CTRL-F5 will force a reload of the image on the server <br/> \
                                         9.   (Some browsers have a timeout to automatically reload a image)'
                                    ,
                                icon:
                                "info"
                            });

                }
         $(document).ready(function() {

