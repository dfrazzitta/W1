         $(document).ready(function() {

               var blink = document.getElementById('blink');
                 setInterval(function() {
                     blink.style.opacity = (blink.style.opacity == 0 ? 1 : 0);
                 }, 500);

           });


         window.addEventListener("load", function() {

            $("#spin").hide(); // Hide the spinner
            console.log("Page and all resources are loaded!");
        });


        function activate()
        {
            alert('activate');
            $.ajax({
              url: "/members/setforsale", // The URL to send the request to
              method: "POST", // HTTP method (e.g., GET, POST, PUT, DELETE)
              dataType: "json", // Expected data type of the server response (e.g., "json", "xml", "html")
              data: {},
              success: function(response) {
                // Function to execute on successful request
                console.log("Success:", response);
              },
              error: function(xhr, status, error) {
                // Function to execute on request failure
                console.error("Error:", status, error);
              },
              complete: function() {
                // Function to execute regardless of success or failure
                console.log("Request complete.");
              }
            });
        }


        function deactivate()
        {
            alert('deactivate');
            $.ajax({
              url: "/members/unsetforsale", // The URL to send the request to
              method: "POST", // HTTP method (e.g., GET, POST, PUT, DELETE)
              dataType: "json", // Expected data type of the server response (e.g., "json", "xml", "html")
              data: {},
              success: function(response) {
                // Function to execute on successful request
                console.log("Success:", response);
              },
              error: function(xhr, status, error) {
                // Function to execute on request failure
                console.error("Error:", status, error);
              },
              complete: function() {
                // Function to execute regardless of success or failure
                console.log("Request complete.");
              }
            });
        }
    </script>
