@model IEnumerable<W1.Models.Member>

@{
    ViewData["Title"] = "Index";
}


<style>
    form {
        text-align: center;
    }
</style>
 

<br />
<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        Homes Listed
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>


<p align="center">
    <a asp-action="Create">Create New Listing</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TypeSell)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LotNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AgentLastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AgentFirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OfficePhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CellPhone)
            </th>
            @*
            <th>
                @Html.DisplayNameFor(model => model.AgentUrl)
            </th>
            *@
            <th>
                @Html.DisplayNameFor(model => model.ImageName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
             
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TypeSell)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LotNo)
                </td>
                <td >
                    @Html.DisplayFor(modelItem => item.Price)
                    
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AgentLastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AgentFirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OfficePhone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CellPhone)
                </td>
                
                <td>
                    @*
                    @Html.DisplayFor(modelItem => item.ImageName)
                    *@
                        <a href=@Html.DisplayFor(modelItem => item.ImageName)>Image</a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                       
                    <a asp-action="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
<br />
@*
 
 *@
 
<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        End Homes Listed
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>

<div class="row" style="background-color:  lightgoldenrodyellow; opacity: .9">
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
    <p align="center" class="rounded-5" style="margin:1px 1px; padding:0px 0px; font-size: 20pt; font-family: Brush Script MT, cursive;">
        <h2 id="blink" align="center" style="color: #be2d2d;">Be Responsible - Remember to logout !!!!!!!!!!</h2>
        
    </p>
    <img class="imgcircle" src="~/red.jpg" alt="palm" width="10" height="10">
</div>

<form align="center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
    <button type="submit" align="center" class="nav-link btn btn-link text-dark">Click here to Logout</button>
</form>
 
 
     
  
 
@section Scripts
{
    <script>


         window.addEventListener("load", function() {

            $("#spin").hide(); // Hide the spinner
            console.log("Page and all resources are loaded!");
        });


        function activate()
        {
            alert('activate');
            $.ajax({
              url: "/home/setforsale", // The URL to send the request to
              method: "POST", // HTTP method (e.g., GET, POST, PUT, DELETE)
              dataType: "json", // Expected data type of the server response (e.g., "json", "xml", "html")
              data: {},
              success: function(response) {
                // Function to execute on successful request
                console.log("Success:", response);
              },
              error: function(xhr, status, error) {
                // Function to execute on request failure
                console.error("Error:", status, error);
              },
              complete: function() {
                // Function to execute regardless of success or failure
                console.log("Request complete.");
              }
            });
        }


        function deactivate()
        {
            alert('deactivate');
            $.ajax({
              url: "/home/unsetforsale", // The URL to send the request to
              method: "POST", // HTTP method (e.g., GET, POST, PUT, DELETE)
              dataType: "json", // Expected data type of the server response (e.g., "json", "xml", "html")
              data: {},
              success: function(response) {
                // Function to execute on successful request
                console.log("Success:", response);
              },
              error: function(xhr, status, error) {
                // Function to execute on request failure
                console.error("Error:", status, error);
              },
              complete: function() {
                // Function to execute regardless of success or failure
                console.log("Request complete.");
              }
            });
        }
    </script>
}
